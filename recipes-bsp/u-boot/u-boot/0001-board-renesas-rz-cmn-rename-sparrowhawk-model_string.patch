From 90910d30ef01a17a9e18a980b28f9dd977de580b Mon Sep 17 00:00:00 2001
From: Son Nguyen <congsonbk09@gmail.com>
Date: Mon, 6 Jul 2026 18:13:03 +0700
Subject: [PATCH] board: renesas: rz-cmn: rename sparrowhawk model_string to
 sparrow-hawk

Align the U-Boot board detection model_string with the hyphenated
'sparrow-hawk' naming used by SUPPORT_TARGETS and platform_info.json
in the Yocto BSP, so board detection matches correctly.

Upstream-Status: Pending
---
 include/configs/rz-cmn_env.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/configs/rz-cmn_env.h b/include/configs/rz-cmn_env.h
index 0edc9fa613f..2956ebda38d 100644
--- a/include/configs/rz-cmn_env.h
+++ b/include/configs/rz-cmn_env.h
@@ -59,7 +59,7 @@
 	RZ_FDT_CASE("rzv2h-evk", "2", "0", "rzv2h-evk-ver1.dtb") \
 	RZ_FDT_CASE("rzv2h-rdk", "1", "0", "rzv2h-rdk-ver1.dtb") \
 	RZ_FDT_CASE("imdt-v2h-sbc", "1", "0", "imdt-v2h-sbc.dtb") \
-	RZ_FDT_CASE("sparrowhawk", "1", "0", "r8a779g3-sparrow-hawk.dtb")
+	RZ_FDT_CASE("sparrow-hawk", "1", "0", "r8a779g3-sparrow-hawk.dtb")
 #endif
 
 /* Built-in overlay flags — add more overlays here */
