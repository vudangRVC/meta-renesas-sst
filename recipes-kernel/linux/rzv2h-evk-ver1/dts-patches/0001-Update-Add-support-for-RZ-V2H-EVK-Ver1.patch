+				  <&cpg CPG_MOD 190>,
+				  <&cpg CPG_MOD 192>,
+				  <&cpg CPG_MOD 191>,
+				  <&cpg CPG_MOD 193>,
+				  <&ptp_clock>;
+			clock-names = "master_bus", "slave_bus", "tx",
