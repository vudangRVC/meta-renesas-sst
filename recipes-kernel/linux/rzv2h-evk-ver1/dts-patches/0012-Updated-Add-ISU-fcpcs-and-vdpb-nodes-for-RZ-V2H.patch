From 48ce888aaaf19bcc28806bd3d9fd8cca134bc360 Mon Sep 17 00:00:00 2001
From: Cong Nguyen <cong.nguyen.zn@renesas.com>
Date: Wed, 2 Apr 2025 02:00:06 +0000
Subject: [PATCH 12/12] [Updated] Add ISU, fcpcs and vdpb nodes for RZ/V2H

Signed-off-by: Cong Nguyen <cong.nguyen.zn@renesas.com>
---
 arch/arm64/boot/dts/renesas/r9a09g057.dtsi | 42 ++++++++++++++++++++++
 arch/arm64/configs/defconfig               |  8 +----
 2 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/renesas/r9a09g057.dtsi b/arch/arm64/boot/dts/renesas/r9a09g057.dtsi
index d1609c525faa..b48b625d8635 100644
--- a/arch/arm64/boot/dts/renesas/r9a09g057.dtsi
+++ b/arch/arm64/boot/dts/renesas/r9a09g057.dtsi
@@ -1369,6 +1369,48 @@ du_out_dsi0: endpoint {
  			};
  		};
 
+		isu: isum@16450000 {
+				compatible = "renesas,isum";
+				reg = <0 0x16450000 0 0x01F4>;
+				interrupts =    <GIC_SPI 867 IRQ_TYPE_EDGE_RISING>,
+								<GIC_SPI 868 IRQ_TYPE_EDGE_RISING>,
+								<GIC_SPI 869 IRQ_TYPE_EDGE_RISING>,
+								<GIC_SPI 870 IRQ_TYPE_EDGE_RISING>,
+								<GIC_SPI 871 IRQ_TYPE_LEVEL_HIGH>,
+								<GIC_SPI 872 IRQ_TYPE_LEVEL_HIGH>,
+								<GIC_SPI 873 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&cpg CPG_MOD 230>,
+						<&cpg CPG_MOD 231>;
+				clock-names = "isu_aclk", "isu_pclk";
+				resets = <&cpg 213>,
+						<&cpg 214>;
+				reset-names = "aresetn", "presetn";
+				renesas,#ch = <0>;
+				renesas,#rpf = <1>;
+				renesas,#wpf = <1>;
+				renesas,has-rs;
+				power-domains = <&cpg>;
+		};
+
+		fcpcs: vcp4@16410000 {
+ 			compatible = "renesas,vcp4-fcpcs";
+ 			reg = <0 0x16410000 0 0x1000>;
+ 			renesas,#ch = <0>;
+ 		};
+
+ 		vdpb: vcp4@16400000 {
+ 			compatible = "renesas,vcp4-vdpb";
+ 			reg = <0 0x16400000 0 0x1000>, <0 0x16420200 0 0xE00>;
+ 			interrupts = <GIC_SPI 887 IRQ_TYPE_LEVEL_HIGH>,
+ 				     <GIC_SPI 888 IRQ_TYPE_LEVEL_HIGH>;
+ 			clocks = <&cpg CPG_MOD 243>,
+ 				 <&cpg CPG_MOD 244>;
+ 			power-domains = <&cpg>;
+ 			resets = <&cpg 224>;
+ 			renesas,#ch = <0>;
+ 			renesas,#fcp_ch = <0>;
+ 		};
+
  		fcpvd: fcp@16470000 {
  			compatible = "renesas,r9a09g057-fcpvd",
  				     "renesas,fcpv";
diff --git a/arch/arm64/configs/defconfig b/arch/arm64/configs/defconfig
index 5d4ec4842bde..7d6ccde91f70 100644
--- a/arch/arm64/configs/defconfig
+++ b/arch/arm64/configs/defconfig
@@ -317,7 +317,6 @@ CONFIG_ARM_SMMU_V3=y
 CONFIG_REMOTEPROC=y
 CONFIG_ARCH_R8A77995=y
 CONFIG_ARCH_R8A77990=y
-CONFIG_ARCH_R8A77950=y
 CONFIG_ARCH_R8A77951=y
 CONFIG_ARCH_R8A77965=y
 CONFIG_ARCH_R8A77960=y
@@ -336,7 +335,6 @@ CONFIG_ARCH_R9A07G044=y
 CONFIG_ARCH_R9A07G054=y
 CONFIG_ARCH_R9A08G045=y
 CONFIG_ARCH_R9A09G011=y
-CONFIG_ARCH_R9A09G047=y
 CONFIG_ARCH_R9A09G057=y
 CONFIG_RENESAS_RPCIF=y
 CONFIG_RENESAS_XSPI=y
@@ -365,7 +363,6 @@ CONFIG_JFFS2_FS=y
 CONFIG_FANOTIFY=y
 CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
 CONFIG_QUOTA=y
-CONFIG_AUTOFS4_FS=y
 CONFIG_VFAT_FS=y
 CONFIG_TMPFS=y
 CONFIG_TMPFS_POSIX_ACL=y
@@ -423,7 +420,4 @@ CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
 # CONFIG_DMIID is not set
 # CONFIG_KEYBOARD_ATKBD is not set
 # CONFIG_HW_RANDOM is not set
-# CONFIG_RAS is not set
-# CONFIG_DMA_PERNUMA_CMA is not set
-CONFIG_LOCALVERSION="-yocto-standard"
-CONFIG_LOCALVERSION_AUTO=n
\ No newline at end of file
+# CONFIG_RAS is not set
\ No newline at end of file
-- 
