From: Quoc Trinh <quoc.trinh.fz@renesas.com>
Subject: [PATCH] arm64: dts: renesas: sparrow-hawk: add OP-TEE firmware node

Enable the Linux OP-TEE SMC driver only on the V4H Sparrow Hawk DTB.

Upstream-Status: Inappropriate [board-specific enablement]
Signed-off-by: Quoc Trinh <quoc.trinh.fz@renesas.com>
---
 arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk.dts b/arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk.dts
--- a/arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk.dts
+++ b/arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk.dts
@@ -199,6 +199,13 @@
 		gpios-states = <1>;
 		states = <1800000 0>, <3300000 1>;
 	};
+
+	firmware {
+		optee {
+			compatible = "linaro,optee-tz";
+			method = "smc";
+		};
+	};
 };
